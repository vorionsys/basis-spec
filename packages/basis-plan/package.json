{
  "name": "@vorionsys/basis-plan",
  "version": "0.1.0",
  "description": "Public reference implementation of BASIS RFC-0006 — symbolic verification of multi-step agent execution plans. Proves over ALL paths that a declared plan cannot violate declared invariants, and publishes a re-runnable SMT-LIB2 artifact so anyone can check the result independently.",
  "keywords": [
    "ai",
    "agent",
    "governance",
    "smt",
    "z3",
    "formal-verification",
    "execution-plan",
    "invariants",
    "basis"
  ],
  "homepage": "https://vorion.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vorionsys/basis-spec.git",
    "directory": "packages/basis-plan"
  },
  "bugs": {
    "url": "https://github.com/vorionsys/basis-spec/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@vorionsys/basis-spec": "^1.3.0",
    "z3-solver": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Vorion LLC",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
