{
  "name": "@vorionsys/basis-spec-conformance",
  "version": "0.4.0",
  "description": "BASIS conformance test suite and public reference verifier for RFC-0002 proof event chains — recomputes canonical-JSON hashes, walks previousHash linkage, and checks detached Ed25519 signatures. Ships golden vectors so anyone can verify a chain without vendor tooling.",
  "keywords": [
    "ai",
    "agent",
    "governance",
    "trust",
    "conformance",
    "test-suite",
    "basis",
    "audit-trail",
    "hash-chain",
    "ed25519",
    "tamper-evident"
  ],
  "homepage": "https://vorion.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vorionsys/basis-spec.git",
    "directory": "packages/basis-conformance"
  },
  "bugs": {
    "url": "https://github.com/vorionsys/basis-spec/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "basis-conformance": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runner": {
      "types": "./dist/runner.d.ts",
      "import": "./dist/runner.js"
    }
  },
  "files": [
    "dist",
    "src",
    "vectors",
    "vitest.config.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/prepare-dist.mjs",
    "typecheck": "tsc --noEmit",
    "vectors": "node scripts/generate-vectors.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "conformance": "vitest run --reporter=default --reporter=json --outputFile=conformance-results.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@vorionsys/basis-spec": "^1.3.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "vitest": "^3.2.6",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Vorion LLC",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
