{
  "name": "@vorionsys/basis-quorum",
  "version": "0.1.0",
  "description": "Public reference implementation of BASIS RFC-0005 — m-of-n threshold authorization for high-consequence agent actions. FROST(Ed25519) quorum signatures that verify with the stock RFC-0002 verifier, plus round verification that makes vote suppression detectable.",
  "keywords": [
    "ai",
    "agent",
    "governance",
    "quorum",
    "threshold-signature",
    "frost",
    "ed25519",
    "multi-agent",
    "authorization",
    "basis"
  ],
  "homepage": "https://vorion.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vorionsys/basis-spec.git",
    "directory": "packages/basis-quorum"
  },
  "bugs": {
    "url": "https://github.com/vorionsys/basis-spec/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "vectors",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "vectors": "node scripts/generate-vectors.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@vorionsys/basis-spec": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vorionsys/basis-spec-conformance": "^0.2.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Vorion LLC",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
